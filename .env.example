# Clave de la API de Anthropic.
# Opcional: si no está, el SDK usa las credenciales de tu sesión de Claude Code.
ANTHROPIC_API_KEY=

# Modelo principal: investigar y redactar. Ver src/config.ts.
CLAUDE_MODEL=claude-opus-5

# Modelo del clasificador. Una pasada sobre un texto corto no necesita el modelo grande.
CLAUDE_MODEL_CLASIFICADOR=claude-haiku-4-5
